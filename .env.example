# LLM Providers
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
DASHSCOPE_API_KEY=
XIAOMIMIMO_API_KEY=
XIAOMIMIMO_BASE_URL=https://token-plan-sgp.xiaomimimo.com/v1

# XHS Platform
XHS_COOKIE=
XHS_USER_ID=
# Real publishing via browser (requires chromium in image). false = mock only.
XHS_USE_BROWSER=false
# CDP 连接已登录的常驻 headed Chrome。设了则 connect_over_cdp 复用该会话。
XHS_CDP_ENDPOINT=
# Engagement only attaches to this account's persistent headed Chrome; no
# CDP means fail closed rather than launching a new browser.
XHS_ENGAGEMENT_COOLDOWN_SECONDS=5
# CDP 多 profile：每账号独立 Chrome user-data-dir + 独立 CDP port。
# chrome_profiles_dir = per-account profile 基础目录（创建账号时自动分配 <dir>/<account_id>）。
# cdp_base_port = 起始 port（创建账号时从 base+1 递增找首个未占用 port）。
XHS_CHROME_PROFILES_DIR=
XHS_CDP_BASE_PORT=9222

# Creator Center statistics import: 0 disables the background worker.
# Only accounts with is_active=true are imported by the worker and sync-all API.
CREATOR_STATS_SYNC_INTERVAL_HOURS=36
# Risk-control tuning for Creator Center imports. Automated runs are overview+
# list-only by default; set a positive integer N explicitly to allow one deep
# enrichment round after every N light runs. Manual sync can still request
# bounded enrichment.
CREATOR_STATS_SCHEDULED_FORCE_LIGHT=1
CREATOR_STATS_DEEP_EVERY_N_RUNS=0
CREATOR_STATS_MIN_REFRESH_HOURS=18
CREATOR_STATS_SAFE_MODE=1
CREATOR_STATS_MAX_LIST_PAGES=5
CREATOR_STATS_MAX_DETAIL_VISITS=4
CREATOR_STATS_MAX_BODY_VISITS=0
CREATOR_STATS_SYNC_COOLDOWN_MINUTES=45
CREATOR_STATS_AUTH_FAIL_COOLDOWN_MINUTES=120
XHS_QR_LOGIN_COOLDOWN_SECONDS=900
XHS_QR_RISK_BLOCK_SECONDS=3600

# Ripple CAS Engine (本地部署)
RIPPLE_BASE_URL=http://127.0.0.1:8080
RIPPLE_API_TOKEN=
RIPPLE_ENABLED=false
RIPPLE_DEFAULT_MAX_WAVES=3
RIPPLE_DEFAULT_SIMULATION_HORIZON=12h
RIPPLE_MAX_WAVES=3
RIPPLE_SIMULATION_HORIZON=12h
RIPPLE_ENSEMBLE_RUNS=1
RIPPLE_REQUEST_TIMEOUT=300
RIPPLE_WORKFLOW_TIMEOUT=1800
# Ripple LLM config — required for simulations; also passed via podman -e to bootstrap llm_config.yaml
RIPPLE_LLM_MODEL_PLATFORM=openai
RIPPLE_LLM_MODEL_NAME=deepseek-v4-flash
RIPPLE_LLM_API_KEY=
RIPPLE_LLM_URL=

# Database
POSTGRES_URI=postgresql://xhs:xhs@localhost:5432/xhs_growth

# Public Showcase governance. Keep the default private; add reviewed internal
# thread IDs here only after explicit approval and redaction review.
XHS_PUBLIC_ID_SECRET=replace-with-a-stable-random-secret
XHS_SHOWCASE_PUBLIC_IDS=
REDIS_URI=redis://localhost:6379/0

# Optional
IMAGE_GEN_API_KEY=
NOTIFICATION_WEBHOOK_URL=
TAVILY_API_KEY=
