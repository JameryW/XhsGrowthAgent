# LLM Providers
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Unused: direct DeepSeek API is disabled in code (all LLM traffic goes through magpie).
DEEPSEEK_API_KEY=
DASHSCOPE_API_KEY=
XIAOMIMIMO_API_KEY=
XIAOMIMIMO_BASE_URL=https://token-plan-sgp.xiaomimimo.com/v1

# magpie LLM gateway (OpenAI-compatible). All agent/ripple LLM calls egress here;
# model refs like "opencode-go/deepseek-v4.1-flash" pick the upstream.
MAGPIE_API_KEY=magpie
MAGPIE_BASE_URL=http://10.0.0.10:3425/v1

# Adaptive Harness policy (E2). Empty = built-in DefaultHarnessPolicy, which is
# byte-identical to legacy behaviour. Set to "module:factory" (e.g.
# "my_pkg.policy:make_policy") to make model routing, per-phase context budget,
# tool limits and escalation targets come from a custom HarnessPolicy. An
# invalid spec fails loudly on first use (HarnessPolicyLoadError) — it never
# silently falls back to defaults, so a typo cannot quietly change production.
XHS_HARNESS_POLICY=

# 前端构建期（host-side build only）
# `scripts/deploy.sh` 在 host 上跑 `npm run build`（dist 再挂载/拷进镜像），所以这些
# VITE_* 只影响构建产物，容器运行时不会读取；`set -a; source .env` 已导出，取消注释
# 即生效。默认值见每行注释，留空/不设即用默认。
# dev server 代理目标（只影响 `npm run dev`，生产 dist 不含它）
# VITE_BACKEND_PROXY_TARGET=http://localhost:8000
# 质量一致性视图开关（'0' 关闭），默认 1
# VITE_QUALITY_CONSISTENCY_V2=1
# 交互遥测上报地址；留空 = 关闭遥测
# VITE_TELEMETRY_ENDPOINT=

# XHS Platform
# Single-account credential fallback for read paths. Multi-account deployments
# use the per-account credential rows in the app DB (those win when present), so
# leave both empty unless this deployment only has one account.
XHS_COOKIE=
XHS_USER_ID=
# Real publishing via browser (requires chromium in image). false = mock only.
XHS_USE_BROWSER=false
# CDP 连接已登录的常驻 headed Chrome。设了则 connect_over_cdp 复用该会话。
XHS_CDP_ENDPOINT=
# Engagement only attaches to this account's persistent headed Chrome; no
# CDP means fail closed rather than launching a new browser.
XHS_ENGAGEMENT_COOLDOWN_SECONDS=5
# CDP 多 profile：每账号独立 Chrome user-data-dir + 独立 CDP port。
# chrome_profiles_dir = per-account profile 基础目录（创建账号时自动分配 <dir>/<account_id>）。
# cdp_base_port = 起始 port（创建账号时从 base+1 递增找首个未占用 port）。
XHS_CHROME_PROFILES_DIR=
XHS_CDP_BASE_PORT=9222

# Creator Center statistics import: 0 disables the background worker.
# Only accounts with is_active=true are imported by the worker and sync-all API.
# 24h base + jitter (triangular 0.65-1.75x -> ~15.6-42h) — roughly once a day.
CREATOR_STATS_SYNC_INTERVAL_HOURS=24
# Risk-control tuning for Creator Center imports. Automated runs are overview+
# list-only by default; set a positive integer N explicitly to allow one
# Creator Center detail-metric round after every N light runs. Public note
# pages are permanently disabled for every sync mode.
CREATOR_STATS_SCHEDULED_FORCE_LIGHT=1
CREATOR_STATS_DEEP_EVERY_N_RUNS=0
CREATOR_STATS_MIN_REFRESH_HOURS=18
CREATOR_STATS_SAFE_MODE=1
CREATOR_STATS_MAX_LIST_PAGES=5
CREATOR_STATS_MAX_DETAIL_VISITS=4
# Legacy compatibility only; ignored permanently (no public /explore navigation).
CREATOR_STATS_MAX_BODY_VISITS=0
CREATOR_STATS_SYNC_COOLDOWN_MINUTES=45
CREATOR_STATS_AUTH_FAIL_COOLDOWN_MINUTES=120
# Human-looking schedule: startup settle, skip days, wake-before-crawl pause,
# 7d/30d mix, long break after success, extra quiet window after risk/auth fails.
CREATOR_STATS_SKIP_DAY_CHANCE=0.25
CREATOR_STATS_STARTUP_DELAY_MIN_SECONDS=600
CREATOR_STATS_STARTUP_DELAY_MAX_SECONDS=2400
CREATOR_STATS_PRE_RUN_DELAY_MIN_SECONDS=45
CREATOR_STATS_PRE_RUN_DELAY_MAX_SECONDS=240
CREATOR_STATS_PERIOD_7D_CHANCE=0.35
CREATOR_STATS_POST_SUCCESS_LONG_BREAK_CHANCE=0.18
CREATOR_STATS_RISK_SKIP_NEXT_CHANCE=0.85
# Cap real successful browser crawls in any rolling 7 days (0 = unlimited).
CREATOR_STATS_MAX_SUCCESSFUL_CRAWLS_PER_WEEK=3
# Temporary preflight skips retry these probes without waiting for the next
# daily crawl window. These probes do not open Creator Center pages.
# CREATOR_STATS_INFRA_RETRY_MINUTES=30
# CREATOR_STATS_PAGE_BUDGET_RETRY_MINUTES=15
# CREATOR_STATS_CDP_BUSY_RETRY_MINUTES=10
# Risk pressure (scheduler): recent risk failures / multi-success weeks force
# list-only crawls, prefer 7d windows, longer settle, multi-cycle quiet arms.
# Quiet arms + soft-risk (empty shell) timestamps are durable across restarts.
# CDP-down skips are infrastructure (not risk) and do not open the circuit.
# Empty shell (prior notes collapsed to 0) = soft risk → cool-down, not success.
# Browser session hygiene: prefer reusing creator tabs; skip when too many pages open.
# CREATOR_STATS_REUSE_TAB_CHANCE=0.65
# CREATOR_STATS_MAX_OPEN_PAGES=8
# CREATOR_STATS_HYGIENE_MAX_CLOSE=3
# Shared CDP mutex (process-local + Postgres advisory when pool is up):
# stats skips when publish/engagement/login holds the profile.
# XHS_CDP_PUBLISH_LOCK_TIMEOUT_S=600
# XHS_CDP_ENGAGEMENT_LOCK_TIMEOUT_S=120
# XHS_CDP_LOGIN_LOCK_TIMEOUT_S=45
# Cross-feature cool-downs after CDP session ends / between publish & engagement.
# XHS_BROWSER_ACTION_COOLDOWN_SECONDS=20
# XHS_PUBLISH_COOLDOWN_SECONDS=90
# XHS_ENGAGEMENT_ACCOUNT_COOLDOWN_SECONDS=30
# Adaptive SAFE_MODE: risk_pressure>=1 clamps like SAFE_MODE; >=2 forces list-only.
XHS_QR_LOGIN_COOLDOWN_SECONDS=900
XHS_QR_RISK_BLOCK_SECONDS=3600
# Outbound DM / comment-reply safety rails (read by xhs_outreach_policy +
# xhs_risk_gate). Leave DM disabled unless the operator explicitly opts in.
XHS_ALLOW_OUTBOUND_DM=0
XHS_DM_DAILY_LIMIT=20
XHS_COMMENT_REPLY_DAILY_LIMIT=50

# Ripple CAS Engine (本地部署)
RIPPLE_BASE_URL=http://127.0.0.1:8080
RIPPLE_API_TOKEN=
RIPPLE_ENABLED=false
RIPPLE_DEFAULT_MAX_WAVES=3
RIPPLE_DEFAULT_SIMULATION_HORIZON=12h
RIPPLE_MAX_WAVES=3
RIPPLE_SIMULATION_HORIZON=12h
RIPPLE_ENSEMBLE_RUNS=1
RIPPLE_REQUEST_TIMEOUT=300
RIPPLE_WORKFLOW_TIMEOUT=1800
# Background mode: content_strategist fires Ripple predict+pmf as a fire-and-forget
# task and returns immediately (≈352s → <10s), instead of blocking the main chain.
# Results are recovered by ripple_late_recheck before review_gate. Set 0 to keep
# the legacy blocking path (useful for debugging Ripple in isolation).
RIPPLE_BACKGROUND=1
# Ripple LLM config — required for simulations; also passed via podman -e to bootstrap llm_config.yaml
RIPPLE_LLM_MODEL_PLATFORM=openai
RIPPLE_LLM_MODEL=opencode-go/deepseek-v4.1-flash
RIPPLE_LLM_MODEL_NAME=opencode-go/deepseek-v4.1-flash
RIPPLE_LLM_API_KEY=
RIPPLE_LLM_URL=http://10.0.0.10:3425/v1

# Database
POSTGRES_URI=postgresql://xhs:xhs@localhost:5432/xhs_growth

# Public Showcase governance. Keep the default private; add reviewed internal
# thread IDs here only after explicit approval and redaction review.
XHS_PUBLIC_ID_SECRET=replace-with-a-stable-random-secret
XHS_SHOWCASE_PUBLIC_IDS=
REDIS_URI=redis://localhost:6379/0

# Optional
NOTIFICATION_WEBHOOK_URL=
# Web search: Tavily Search/Extract is the provider. DeepSeek Search/Fetch is
# disabled in code (2026-11-02) so no request goes directly to api.deepseek.com.
# Without TAVILY_API_KEY, trend_scout keeps the LLM/XHS degrade path.
TAVILY_API_KEY=

# Memory store semantic search (LangGraph BaseStore index). Optional: without
# an embed model the store degrades to namespace-recency only (no semantic
# recall). Leave empty for defaults (openai:text-embedding-3-small, 1536 dims);
# openai/openai_compatible need an API key. On-device CPU example:
# XHS_EMBED_MODEL=local:BAAI/bge-small-zh-v1.5 + XHS_EMBED_DIMS=512 (no key;
# requires langchain-huggingface + sentence-transformers).
XHS_EMBED_MODEL=
XHS_EMBED_DIMS=
XHS_EMBED_BASE_URL=

# Hy Memory (hy-memory) long-term memory engine. Disabled by default: with
# HYMEMORY_ENABLED=false the integration is a no-op (no SDK import, no client,
# no requests). Requires the optional extra: pip install -e ".[memory-hy]".
# NOTE: the deploy image only installs .[browser], so these variables are
# host/dev-only and are intentionally NOT passed into the container; set them
# only where the SDK is actually installed.
# chat scene = account profile/preferences (L0-L7); working scene = reusable
# operational experience (facts + experiences). Per-account isolation is
# automatic (user_id=account_id, workspace_id=xhs/<account_id>,
# source=xhs_growth). Any OpenAI-compatible LLM/embedder works.
HYMEMORY_ENABLED=false
# lite = raw memory + vector search (no LLM); pro = LLM extraction + conflict
# reconciliation; ultra = + System-2 schema induction (needs graph store).
HYMEMORY_MODE=lite
# LLM endpoint for pro/ultra extraction (leave empty for lite).
HYMEMORY_LLM_API_KEY=
HYMEMORY_LLM_BASE_URL=
HYMEMORY_LLM_MODEL=
# Embedder endpoint (required for vector search in every mode).
HYMEMORY_EMBEDDER_API_KEY=
HYMEMORY_EMBEDDER_BASE_URL=
HYMEMORY_EMBEDDER_MODEL=
HYMEMORY_EMBEDDING_DIMS=0
# Data dir (Chroma persistence + SQLite metadata + SDK logs). Empty = SDK
# default ~/.hy_memory. Container deployments should point at a volume.
HYMEMORY_DATA_DIR=
# Default scene (chat | working | coding) and per-recall result cap (1-50).
HYMEMORY_DEFAULT_SCENE=chat
HYMEMORY_DEFAULT_LIMIT=5
# Source isolation tag used in include_sources on recall.
HYMEMORY_SOURCE=xhs_growth
